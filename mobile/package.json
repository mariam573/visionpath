{
  "name": "visionpath-mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "eas:link": "pnpm dlx eas-cli@25.3.0 init",
    "eas:configure": "pnpm dlx eas-cli@25.3.0 build:configure",
    "build:android:development": "pnpm dlx eas-cli@25.3.0 build --platform android --profile development",
    "build:android:preview": "pnpm dlx eas-cli@25.3.0 build --platform android --profile preview",
    "build:android:production": "pnpm dlx eas-cli@25.3.0 build --platform android --profile production"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-build-properties": "~58.0.11",
    "expo-dev-client": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-fast-tflite": "3.0.1",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-resizer": "5.2.3",
    "react-native-vision-camera-worklets": "5.2.3",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
