# Backend runtime settings. Never commit secrets.

# PostgreSQL only; create a local/development database and apply Alembic first.
DATABASE_URL=postgresql+psycopg://visionpath:CHANGE_ME@127.0.0.1:5432/visionpath

# OIDC resource-server settings from the managed identity provider.
# Issuer and audience must match its signed access tokens exactly.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=

# Set to the reviewed consent/privacy policy version shown in the client.
CONSENT_POLICY_VERSION=

HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=info
# Comma-separated local development origins. Wildcards are rejected.
ALLOWED_ORIGINS=http://localhost,http://10.0.2.2
